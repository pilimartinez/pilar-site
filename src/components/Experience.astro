---
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="work" aria-labelledby="work-heading" class="mt-24 sm:mt-32">
  <h2
    id="work-heading"
    class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)]"
  >
    Selected work
  </h2>

  <div class="mt-8 divide-y divide-[var(--border)] border-t border-[var(--border)]">
    {
      work.map((entry) => (
        <article class="py-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
              {entry.data.company}
            </h3>
            <p class="text-sm text-[var(--muted)]">{entry.data.period}</p>
          </div>

          <p class="mt-1 text-sm font-medium text-[var(--accent)]">
            {entry.data.role}
          </p>

          <p class="mt-4 max-w-prose leading-relaxed text-pretty text-[var(--fg)]/90">
            {entry.data.summary}
          </p>

          {entry.data.tech && (
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Stack">
              {entry.data.tech.map((t) => (
                <li class="rounded-full border border-[var(--border)] px-3 py-1 text-xs font-medium text-[var(--muted)]">
                  {t}
                </li>
              ))}
            </ul>
          )}

          {entry.data.links && entry.data.links.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
              {entry.data.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-1.5 text-[var(--accent)] transition-opacity hover:opacity-80"
                  >
                    {link.label}
                    <span
                      aria-hidden="true"
                      class="transition-transform group-hover:translate-x-0.5"
                    >
                      &rarr;
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>
