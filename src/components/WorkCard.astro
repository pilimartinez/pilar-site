---
interface Props {
  href: string;
  title: string;
  role: string;
  company: string;
  period: string;
  tech: string[];
  summary: string;
}

const { href, title, role, company, period, tech, summary } = Astro.props;
---

<article
  class="group relative rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 transition-colors hover:border-[var(--accent)] sm:p-8"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
      <a href={href} class="after:absolute after:inset-0" aria-label={`${title} case study`}>
        {title}
      </a>
    </h3>
    <p class="text-sm text-[var(--muted)]">{period}</p>
  </div>

  <p class="mt-1 text-sm font-medium text-[var(--muted)]">
    {role} · {company}
  </p>

  <p class="mt-4 max-w-prose text-[var(--fg)]/90">{summary}</p>

  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
    {
      tech.map((t) => (
        <li class="rounded-full border border-[var(--border)] px-3 py-1 text-xs font-medium text-[var(--muted)]">
          {t}
        </li>
      ))
    }
  </ul>

  <p
    class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)]"
  >
    Read case study
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
      &rarr;
    </span>
  </p>
</article>
