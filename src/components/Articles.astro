---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => a.data.order - b.data.order
);

// ISO date (yyyy-mm-dd) → "Mar 2024". Parsed at noon UTC to avoid TZ drift.
function formatDate(iso: string): string {
  return new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  });
}
---

{
  articles.length > 0 && (
    <section
      id="articles"
      aria-labelledby="articles-heading"
      class="mt-24 sm:mt-32"
    >
      <h2
        id="articles-heading"
        class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)]"
      >
        Articles
      </h2>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {articles.map((article) => (
          <a
            href={article.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 transition-colors hover:border-[var(--accent)]"
          >
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium uppercase tracking-wide text-[var(--muted)]">
              {article.data.date && (
                <>
                  <time datetime={article.data.date}>
                    {formatDate(article.data.date)}
                  </time>
                  <span aria-hidden="true">·</span>
                </>
              )}
              <span>{article.data.topic}</span>
            </div>

            <h3 class="mt-2 font-semibold leading-snug tracking-tight text-pretty group-hover:text-[var(--accent)]">
              {article.data.title}
            </h3>

            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--accent)]">
              {article.data.publication}
              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-0.5"
              >
                &rarr;
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
