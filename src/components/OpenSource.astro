---
// ─────────────────────────────────────────────────────────────────────────
// EDIT ME: open-source links. Add/remove items here — the list renders itself.
// Each item: { label, url, context (optional one-liner), tech (optional tags) }
// ─────────────────────────────────────────────────────────────────────────
const projects: {
  label: string;
  url: string;
  context?: string;
  tech?: string[];
}[] = [
  {
    label: 'terraform-provider-checkly',
    url: 'https://github.com/checkly/terraform-provider-checkly',
    context: 'Manage Checkly monitoring as code with Terraform.',
    tech: ['Terraform', 'Go'],
  },
  {
    label: 'checkly-go-sdk',
    url: 'https://github.com/checkly/checkly-go-sdk',
    context: "Go client for Checkly's public API.",
    tech: ['Go'],
  },
  // TODO: add more repos / specific PRs here as you like, same shape as above.
];
---

<section id="open-source" aria-labelledby="oss-heading" class="mt-24 sm:mt-32">
  <h2
    id="oss-heading"
    class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)]"
  >
    Open source
  </h2>
  <p class="mt-6 max-w-prose text-lg text-[var(--muted)]">
    During my open-source year at Checkly I built and maintained developer
    tooling around the public API — configuring and managing monitoring as code
    across Node.js, Terraform, Go and Vue. A few of those projects:
  </p>

  <ul class="mt-8 divide-y divide-[var(--border)] border-y border-[var(--border)]">
    {
      projects.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-wrap items-baseline gap-x-3 gap-y-1 py-4 transition-colors hover:text-[var(--accent)]"
          >
            <span class="font-medium">{p.label}</span>
            {p.tech && (
              <span class="text-xs text-[var(--muted)]">{p.tech.join(' · ')}</span>
            )}
            {p.context && (
              <span class="w-full text-sm text-[var(--muted)] sm:w-auto sm:flex-1">
                {p.context}
              </span>
            )}
            <span
              aria-hidden="true"
              class="text-[var(--muted)] transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--accent)]"
            >
              &rarr;
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-sm text-[var(--muted)]">
    More on
    <a
      href="https://github.com/pilimartinez"
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-[var(--fg)] underline decoration-[var(--border)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
    >
      github.com/pilimartinez
    </a>.
  </p>
</section>
